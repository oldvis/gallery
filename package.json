{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 3333 --open",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "bench:embed": "BENCH_EMBED=1 playwright test e2e/bench-embed.spec.ts",
    "docs:screenshot": "DOCS_SCREENSHOT=1 playwright test e2e/docs-screenshot.spec.ts",
    "up": "taze major -I"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@vueuse/core": "^14.4.0",
    "ajv": "^8.20.0",
    "d3": "^7.9.0",
    "fuse.js": "^7.5.0",
    "iso-639-3": "^3.0.1",
    "lodash": "^4.18.1",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sift": "^17.1.3",
    "uuid": "^14.0.1",
    "v-object-inspector": "^0.1.3",
    "vue": "^3.5.40",
    "vue-gtag": "^3.7.1",
    "vue-router": "^5.2.0",
    "with-progress-bar": "^0.1.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@playwright/test": "^1.62.1",
    "@types/d3": "^7.4.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.1.2",
    "@unocss/eslint-config": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue-macros/volar": "^3.1.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "sass": "^1.102.0",
    "taze": "^19.17.1",
    "typescript": "^6.0.2",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "^8.2.0",
    "vite-plugin-pages": "^0.33.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
